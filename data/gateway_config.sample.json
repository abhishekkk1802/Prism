{
  "_comment": "Sample gateway pack: two mock providers (alpha, beta), tiered aliases, and an auto alias that routes by prompt difficulty. Mirrors the shape the gateway loads from gateway-config.json, and is cross-checked against model_pricing.json by validate_pack.py.",
  "providers": [
    {
      "name": "alpha",
      "base_url": "http://localhost:9001/v1",
      "api_key": "mock-key-alpha"
    },
    {
      "name": "beta",
      "base_url": "http://localhost:9002/v1",
      "api_key": "mock-key-beta"
    }
  ],
  "model_aliases": {
    "fast": {
      "primary": "alpha-small",
      "fallbacks": ["beta-small"]
    },
    "smart": {
      "primary": "alpha-large",
      "fallbacks": ["beta-large"]
    },
    "auto": {
      "route_by_difficulty": {
        "simple": "fast",
        "complex": "smart"
      }
    }
  },
  "retry": {
    "max_attempts": 3,
    "initial_backoff_ms": 200,
    "backoff_multiplier": 2
  }
}
